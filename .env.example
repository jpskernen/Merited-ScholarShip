# Firebase Configuration (Next.js Public Variables)
# Get these from the Firebase Console (Project Settings > General > Your Apps)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# Organization that new applicant accounts join, until per-organization signup
# links exist (docs/08 runbook 2.5). Must match an organizations/{orgId} document.
NEXT_PUBLIC_DEFAULT_ORG_ID=your-org-id

# AI Configuration
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# Email (Gmail SMTP via nodemailer)
# GMAIL_USER must be a full Gmail address; GMAIL_APP_PASSWORD is a 16-char
# App Password from https://myaccount.google.com/apppasswords (requires 2FA enabled)
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_FROM_EMAIL=your-address@gmail.com

# Firebase Admin SDK (server-only; trusted server actions use this instead of
# the client SDK so writes aren't blocked by Firestore security rules).
# Get these from Firebase Console > Project Settings > Service Accounts >
# Generate New Private Key, which downloads a JSON file with these fields.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the literal \n sequences from the downloaded JSON's private_key field;
# they're unescaped at runtime in src/firebase/admin.ts.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Email branding -------------------------------------------------------
# Base URL of the deployed app. Used for the buttons and footer link in
# outbound emails; when unset those are simply omitted.
NEXT_PUBLIC_APP_URL=https://your-app.example.com
# Optional. By default the header logo is attached to each message and shown
# via Content-ID, using public/email-logo.png — that works on localhost too, so
# nothing needs configuring. Point this at a hosted copy of the same square
# mark to send it as a normal <img src> instead and keep messages smaller.
# EMAIL_LOGO_URL=https://your-app.example.com/email-logo.png
