/* ------------------------------ CSV importer ------------------------------ */
function CSVDrop({ onParsed, fieldConfig, kindLabel }) {
  const [mode, setMode] = useState("upload");
  const [pasteText, setPasteText] = useState("");
  const [error, setError] = useState("");
  const fileInputRef = useRef(null);

  const handleText = (text) => {
    try {
      const { headers, rows } = parseCSVText(text);
      if (!headers.length || !rows.length) {
        setError("Couldn't find any rows. Check the file has a header row plus at least one data row.");
        return;
      }
      setError("");
      onParsed({ headers, rows });
    } catch (e) {
      setError("Couldn't parse that as CSV.");
    }
  };

  const handleFile = async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const text = await readFileAsText(file);
    handleText(text);
  };

  return (
    <div>
      <div style={{ display: "flex", gap: 8, marginBottom: 14 }}>
        <button onClick={() => setMode("upload")} style={{
          ...sans, fontSize: 13, fontWeight: 600, padding: "6px 12px", borderRadius: 6, cursor: "pointer",
          border: `1px solid ${mode === "upload" ? C.navy : C.line}`,
          background: mode === "upload" ? C.navy : "transparent", color: mode === "upload" ? C.white : C.ink,
        }}>Upload file</button>
        <button onClick={() => setMode("paste")} style={{
          ...sans, fontSize: 13, fontWeight: 600, padding: "6px 12px", borderRadius: 6, cursor: "pointer",
          border: `1px solid ${mode === "paste" ? C.navy : C.line}`,
          background: mode === "paste" ? C.navy : "transparent", color: mode === "paste" ? C.white : C.ink,
        }}>Paste CSV</button>
      </div>

      {mode === "upload" ? (
        <div
          onClick={() => fileInputRef.current && fileInputRef.current.click()}
          style={{
            border: `1.5px dashed ${C.line}`, borderRadius: 10, padding: "34px 20px", textAlign: "center",
            cursor: "pointer", background: C.paper,
          }}
        >
          <Upload size={22} color={C.blueDeep} style={{ marginBottom: 8 }} />
          <div style={{ fontSize: 14, fontWeight: 600, color: C.ink, ...sans }}>Click to choose a CSV of your {kindLabel}</div>
          <div style={{ fontSize: 12, color: "#8a8577", marginTop: 4, ...sans }}>Exported from your current spreadsheet or system</div>
          <input ref={fileInputRef} type="file" accept=".csv,text/csv" onChange={handleFile} style={{ display: "none" }} />
        </div>
      ) : (
        <div>
          <textarea
            value={pasteText}
            onChange={(e) => setPasteText(e.target.value)}
            placeholder={"name,email,role\nJane Diaz,jane@foundation.org,admin\nSam Lee,sam@foundation.org,reviewer"}
            rows={7}
            style={{ ...inputStyle, fontFamily: "monospace", fontSize: 13, resize: "vertical" }}
          />
          <Btn onClick={() => handleText(pasteText)} style={{ marginTop: 10 }} variant="accent">
            Parse pasted data <ArrowRight size={14} />
          </Btn>
        </div>
      )}
      {error && (
        <div style={{ display: "flex", gap: 7, alignItems: "flex-start", marginTop: 12, color: C.bad, fontSize: 13, ...sans }}>
          <AlertCircle size={15} style={{ marginTop: 1, flexShrink: 0 }} /> {error}
        </div>
      )}
    </div>
  );
}

