
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // High-security check for administrative privileges
    function isSponsor() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role in ['sponsor', 'Admin', 'Sponsor']) ||
        request.auth.token.email == 'peyton.vandenbemden@gmail.com'
      );
    }

    // Check for reviewer registry or specific user role
    function isReviewer() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Reviewer') ||
        exists(/databases/$(database)/documents/reviewers/$(request.auth.uid)) ||
        isSponsor()
      );
    }

    // Role Admin Collection
    match /roles_admin/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSponsor());
      allow write: if false; 
    }

    // Reviewer Invites
    match /invites/{inviteId} {
      allow read: if true;
      allow write: if isSponsor();
    }

    // Admin Invites
    match /admin_invites/{inviteId} {
      allow read: if true;
      allow write: if isSponsor();
    }

    // User Profiles
    match /users {
      allow list: if isSignedIn() && (isSponsor() || isReviewer());
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSponsor() || isReviewer());
      allow write: if isSignedIn() && (request.auth.uid == userId || isSponsor());
    }

    // Reviewers Registry
    match /reviewers/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSponsor());
      allow write: if isSponsor() || (isSignedIn() && request.auth.uid == userId);
    }

    // Applications & Reviews
    match /applications/{appId} {
      allow read: if isSignedIn() && (
        (resource != null && request.auth.uid == resource.data.applicantId) || 
        isSponsor() || 
        isReviewer()
      );
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource != null && request.auth.uid == resource.data.applicantId) || 
        isSponsor() || 
        isReviewer()
      );

      match /reviews/{reviewId} {
        allow read: if isSignedIn() && (isSponsor() || isReviewer() || (resource != null && request.auth.uid == resource.data.reviewerId));
        allow write: if isSignedIn() && (isSponsor() || isReviewer());
      }
    }

    // Programs are public for viewing
    match /programs/{programId} {
      allow read: if true;
      allow write: if isSponsor();
    }

    // Allow collection group queries for reviews
    match /{path=**}/reviews/{reviewDoc} {
      allow read, list: if isSignedIn() && (isSponsor() || isReviewer());
    }
  }
}
