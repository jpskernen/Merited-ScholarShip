/* ------------------------------ scoring matrix ----------------------------- */
function MatrixEditor({ matrix, onChange, onSaveName }) {
  const total = matrix.criteria.reduce((s, c) => s + (Number(c.weight) || 0), 0);
  const update = (id, patch) =>
    onChange({ ...matrix, criteria: matrix.criteria.map((c) => (c.id === id ? { ...c, ...patch } : c)) });
  const remove = (id) => onChange({ ...matrix, criteria: matrix.criteria.filter((c) => c.id !== id) });
  const add = () => onChange({ ...matrix, criteria: [...matrix.criteria, { id: uid("c"), name: "New criterion", weight: 0 }] });

  return (
    <div>
      <Field label="Matrix name">
        <input style={inputStyle} value={matrix.name} onChange={(e) => onSaveName(e.target.value)} />
      </Field>
      <div style={{ border: `1px solid ${C.line}`, borderRadius: 8, overflow: "hidden" }}>
        <table style={{ width: "100%", borderCollapse: "collapse", ...sans }}>
          <thead>
            <tr style={{ background: C.paper }}>
              <th style={th}>Criterion</th>
              <th style={{ ...th, width: 120 }}>Weight %</th>
              <th style={{ ...th, width: 40 }}></th>
            </tr>
          </thead>
          <tbody>
            {matrix.criteria.map((c) => (
              <tr key={c.id} style={{ borderTop: `1px solid ${C.line}` }}>
                <td style={td}>
                  <input style={{ ...inputStyle, padding: "6px 9px" }} value={c.name} onChange={(e) => update(c.id, { name: e.target.value })} />
                </td>
                <td style={td}>
                  <input
                    type="number" min={0} max={100} style={{ ...inputStyle, padding: "6px 9px" }}
                    value={c.weight} onChange={(e) => update(c.id, { weight: Number(e.target.value) })}
                  />
                </td>
                <td style={{ ...td, textAlign: "center" }}>
                  <button onClick={() => remove(c.id)} style={{ background: "none", border: "none", cursor: "pointer", color: C.bad }}>
                    <Trash2 size={15} />
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 12 }}>
        <button onClick={add} style={{ ...sans, fontSize: 13, fontWeight: 600, color: C.blueDeep, background: "none", border: "none", cursor: "pointer", display: "flex", alignItems: "center", gap: 5 }}>
          <Plus size={15} /> Add criterion
        </button>
        <div style={{ display: "flex", alignItems: "center", gap: 7, fontSize: 13, fontWeight: 700, color: total === 100 ? C.good : C.bad, ...sans }}>
          {total === 100 ? <CircleCheck size={15} /> : <CircleAlert size={15} />}
          Total: {total}%
        </div>
      </div>
    </div>
  );
}

/* ------------------------------ onboarding wizard --------------------------- */
function OnboardingWizard({ onComplete }) {
  const [step, setStep] = useState(0);
  const [orgName, setOrgName] = useState("");

  const [teamData, setTeamData] = useState(null); // {headers, rows}
  const [teamMapping, setTeamMapping] = useState({});

  const [schData, setSchData] = useState(null);
  const [schMapping, setSchMapping] = useState({});
  const [skipScholarships, setSkipScholarships] = useState(false);

  const [matrixChoice, setMatrixChoice] = useState("default");
  const [customMatrix, setCustomMatrix] = useState({ id: "default", name: "Default Scoring Matrix", criteria: DEFAULT_CRITERIA.map((c) => ({ ...c })) });

  const labels = ["Organization", "Team", "Scholarships", "Scoring", "Review"];

  const teamPreview = useMemo(() => {
    if (!teamData) return [];
    return teamData.rows.map((r) => {
      const name = r[teamMapping.name] || "";
      const email = r[teamMapping.email] || "";
      const { role, guessed } = normalizeRole(r[teamMapping.role]);
      return { name, email, role, guessed, raw: r };
    }).filter((r) => r.email);
  }, [teamData, teamMapping]);

  const schPreview = useMemo(() => {
    if (!schData) return [];
    return schData.rows.map((r) => ({
      name: r[schMapping.name] || "",
      amount: schMapping.amount ? r[schMapping.amount] || "" : "",
      deadline: schMapping.deadline ? r[schMapping.deadline] || "" : "",
      description: schMapping.description ? r[schMapping.description] || "" : "",
      eligibility: schMapping.eligibility ? r[schMapping.eligibility] || "" : "",
    })).filter((r) => r.name);
  }, [schData, schMapping]);

  const canAdvance = () => {
    if (step === 0) return orgName.trim().length > 0;
    if (step === 1) return true; // team import optional
    if (step === 2) return true; // scholarships optional
    if (step === 3) return matrixChoice === "default" || customMatrix.criteria.reduce((s, c) => s + Number(c.weight || 0), 0) === 100;
    return true;
  };

  const finish = () => {
    const users = teamPreview.map((r) => ({ id: uid("u"), name: r.name, email: r.email, role: r.role }));
    const matrixToUse = matrixChoice === "default"
      ? { id: "default", name: "Default Scoring Matrix", isDefault: true, criteria: DEFAULT_CRITERIA.map((c) => ({ ...c })) }
      : { ...customMatrix, id: "default", isDefault: true };
    const scholarships = schPreview.map((r) => ({
      id: uid("s"), name: r.name, amount: r.amount, deadline: r.deadline,
      description: r.description, eligibility: r.eligibility, matrixId: "default", status: "active",
    }));
    onComplete({ onboarded: true, orgName, users, scholarships, matrices: [matrixToUse] });
  };

  return (
    <div style={{ maxWidth: 780, margin: "0 auto", padding: "48px 24px" }}>
      <Steps labels={labels} current={step} />

      {step === 0 && (
        <div>
          <h2 style={h2}>Welcome to Merited</h2>
          <p style={pText}>Let's get your foundation set up. This takes about three minutes — bring your current spreadsheet of reviewers and any scholarships you already run.</p>
          <Field label="Organization name">
            <input style={inputStyle} value={orgName} onChange={(e) => setOrgName(e.target.value)} placeholder="e.g. Riverside Community Foundation" />
          </Field>
        </div>
      )}

      {step === 1 && (
        <div>
          <h2 style={h2}>Import your team</h2>
          <p style={pText}>Bring in the people who already review or administer scholarships — no need to re-add them one by one. We'll match columns automatically from your file.</p>
          {!teamData ? (
            <CSVDrop kindLabel="reviewers and admins" fieldConfig={USER_FIELDS} onParsed={(d) => { setTeamData(d); setTeamMapping(guessMapping(d.headers, USER_FIELDS)); }} />
          ) : (
            <>
              <ColumnMapper headers={teamData.headers} mapping={teamMapping} setMapping={setTeamMapping} fieldConfig={USER_FIELDS} />
              <PreviewTable
                rows={teamPreview.slice(0, 8)}
                columns={[
                  { key: "name", label: "Name" },
                  { key: "email", label: "Email" },
                  { key: "role", label: "Role", render: (r) => (
                    <span style={{ display: "flex", alignItems: "center", gap: 6 }}>
                      <Badge role={r.role} />
                      {r.guessed && <span style={{ fontSize: 11, color: C.gold }}>couldn't detect — defaulted</span>}
                    </span>
                  ) },
                ]}
              />
              <p style={{ ...pText, fontSize: 12.5, marginTop: 8 }}>{teamPreview.length} people found. {teamPreview.length > 8 ? "Showing first 8." : ""}</p>
              <button onClick={() => { setTeamData(null); }} style={linkBtn}>Start over with a different file</button>
            </>
          )}
        </div>
      )}

      {step === 2 && (
        <div>
          <h2 style={h2}>Import existing scholarships</h2>
          <p style={pText}>Already running scholarships elsewhere? Upload your list once and skip the retyping.</p>
          {!skipScholarships && !schData && (
            <>
              <CSVDrop kindLabel="scholarships" fieldConfig={SCHOLARSHIP_FIELDS} onParsed={(d) => { setSchData(d); setSchMapping(guessMapping(d.headers, SCHOLARSHIP_FIELDS)); }} />
              <button onClick={() => setSkipScholarships(true)} style={linkBtn}>I'll add scholarships later</button>
            </>
          )}
          {schData && (
            <>
              <ColumnMapper headers={schData.headers} mapping={schMapping} setMapping={setSchMapping} fieldConfig={SCHOLARSHIP_FIELDS} />
              <PreviewTable
                rows={schPreview.slice(0, 8)}
                columns={[
                  { key: "name", label: "Name" },
                  { key: "amount", label: "Amount" },
                  { key: "deadline", label: "Deadline" },
                ]}
              />
              <p style={{ ...pText, fontSize: 12.5, marginTop: 8 }}>{schPreview.length} scholarships found. {schPreview.length > 8 ? "Showing first 8." : ""}</p>
              <button onClick={() => { setSchData(null); }} style={linkBtn}>Start over with a different file</button>
            </>
          )}
          {skipScholarships && (
            <div style={{ ...pText, fontStyle: "italic" }}>
              Skipping for now — you can add or import scholarships anytime from the Scholarships tab.
              <div><button onClick={() => setSkipScholarships(false)} style={linkBtn}>Actually, let me import</button></div>
            </div>
          )}
        </div>
      )}

      {step === 3 && (
        <div>
          <h2 style={h2}>Set up scoring</h2>
          <p style={pText}>Every scholarship needs a way to score applicants. Start with our default rubric, or build your own — you can always add more matrices later.</p>
          <div style={{ display: "flex", gap: 10, marginBottom: 20 }}>
            <button onClick={() => setMatrixChoice("default")} style={choiceCard(matrixChoice === "default")}>
              <Sparkles size={17} color={C.blueDeep} />
              <div style={{ fontWeight: 700, fontSize: 14, marginTop: 6 }}>Use the default matrix</div>
              <div style={{ fontSize: 12.5, color: "#7a7568", marginTop: 3 }}>5 balanced criteria most foundations start with</div>
            </button>
            <button onClick={() => setMatrixChoice("custom")} style={choiceCard(matrixChoice === "custom")}>
              <Pencil size={17} color={C.blueDeep} />
              <div style={{ fontWeight: 700, fontSize: 14, marginTop: 6 }}>Build my own</div>
              <div style={{ fontSize: 12.5, color: "#7a7568", marginTop: 3 }}>Define your own criteria and weights</div>
            </button>
          </div>
          {matrixChoice === "default" ? (
            <div style={{ border: `1px solid ${C.line}`, borderRadius: 8, padding: 16 }}>
              {DEFAULT_CRITERIA.map((c) => (
                <div key={c.id} style={{ display: "flex", justifyContent: "space-between", padding: "6px 0", fontSize: 13.5, ...sans }}>
                  <span>{c.name}</span><span style={{ fontWeight: 700 }}>{c.weight}%</span>
                </div>
              ))}
            </div>
          ) : (
            <MatrixEditor matrix={customMatrix} onChange={setCustomMatrix} onSaveName={(name) => setCustomMatrix({ ...customMatrix, name })} />
          )}
        </div>
      )}

      {step === 4 && (
        <div>
          <h2 style={h2}>Review & finish</h2>
          <p style={pText}>Here's what we'll set up for {orgName || "your organization"}.</p>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 12, marginTop: 8 }}>
            <SummaryCard icon={<Users size={16} />} label="Team members" value={teamPreview.length} />
            <SummaryCard icon={<Award size={16} />} label="Scholarships imported" value={schPreview.length} />
            <SummaryCard icon={<ClipboardList size={16} />} label="Scoring matrix" value={matrixChoice === "default" ? "Default" : customMatrix.name} />
          </div>
        </div>
      )}

      <div style={{ display: "flex", justifyContent: "space-between", marginTop: 34 }}>
        <Btn variant="ghost" disabled={step === 0} onClick={() => setStep(step - 1)}><ChevronLeft size={15} /> Back</Btn>
        {step < labels.length - 1 ? (
          <Btn variant="accent" disabled={!canAdvance()} onClick={() => setStep(step + 1)}>Continue <ChevronRight size={15} /></Btn>
        ) : (
          <Btn variant="primary" onClick={finish}>Finish setup <Check size={15} /></Btn>
        )}
      </div>
    </div>
  );
}
