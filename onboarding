  const preview = useMemo(() => {
    if (!data) return [];
    return data.rows.map((r) => ({
      name: r[mapping.name] || "", amount: mapping.amount ? r[mapping.amount] || "" : "",
      deadline: mapping.deadline ? r[mapping.deadline] || "" : "",
      description: mapping.description ? r[mapping.description] || "" : "",
      eligibility: mapping.eligibility ? r[mapping.eligibility] || "" : "",
    })).filter((r) => r.name);
  }, [data, mapping]);

  const doImport = () => {
    const rows = preview.map((r) => ({ id: uid("s"), status: "active", matrixId: "default", ...r }));
