rules_version = '2';

// Tenant isolation (docs/07 §3.4, T6).
//
// Roles come only from the login token's custom claims, which only server code
// can set (src/lib/auth-server.ts setUserClaims):
//   { orgId: string, role: 'org_admin' | 'reviewer' | 'applicant', platformAdmin?: true }
// No role documents and no hardcoded emails are consulted.
//
// Every tenant document carries `organizationId`, and access requires it to
// equal the caller's `orgId` claim. A platform admin passes the organization
// check. Server actions use the Admin SDK and bypass these rules; everything
// trust-sensitive (submit, invites, recommendation letters, claims, audit log,
// email) goes through them (docs/07 §3.5). Anything not matched below is denied.
//
// Tests: tests/rules/ (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function claim(name) {
      return signedIn() ? request.auth.token.get(name, null) : null;
    }

    function isPlatformAdmin() {
      return claim('platformAdmin') == true;
    }

    function inOrg(orgId) {
      return orgId != null && claim('orgId') == orgId;
    }

    function isOrgAdmin(orgId) {
      return isPlatformAdmin() || (inOrg(orgId) && claim('role') == 'org_admin');
    }

    // Reviewers and org admins of the organization.
    function isOrgStaff(orgId) {
      return isOrgAdmin(orgId) || (inOrg(orgId) && claim('role') == 'reviewer');
    }

    // The organization whose scholarships the public landing page lists
    // (docs/07 D7). Must equal NEXT_PUBLIC_DEFAULT_ORG_ID: rules can't read
    // environment variables.
    function defaultOrgId() {
      return 'scholarship-hib4j';
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function programOf(programId) {
      return get(/databases/$(database)/documents/programs/$(programId)).data;
    }

    // ---------------------------------------------------------------- users
    // Shared profile. The user can't set or change their role, organization
    // or status: the server sets those (completeSignup, invites, migrations).
    match /users/{userId} {
      function protectedUserFields() {
        return ['id', 'role', 'organizationId', 'schoolId', 'status', 'welcomeEmailSentAt'];
      }

      allow get: if signedIn() && (
        request.auth.uid == userId ||
        isOrgStaff(resource.data.organizationId)
      );
      allow list: if isOrgAdmin(resource.data.organizationId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if signedIn() && (
        (request.auth.uid == userId && !changed().hasAny(protectedUserFields())) ||
        // The applicants page mirrors the application status onto the profile.
        (isOrgAdmin(resource.data.organizationId) && changed().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if false;
    }

    // -------------------------------------------------------- organizations
    // Created and suspended by the server (Platform Admin actions). The
    // former organizations/{orgId}/{document=**} wildcard, which let any
    // signed-in user write anything here, is gone (S4).
    match /organizations/{orgId} {
      allow get: if inOrg(orgId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow update: if isOrgAdmin(orgId)
        && !changed().hasAny(['id', 'status', 'createdAt', 'createdBy']);
      allow create, delete: if false;

      // Self-service settings (docs/07 §4).
      match /config/{docId} {
        allow read: if inOrg(orgId) || isPlatformAdmin();
        allow write: if isOrgAdmin(orgId);
      }
    }

    // ------------------------------------------------- programs (scholarships)
    // Option A (docs/07 D7): a signed-in user reads only their organization's
    // scholarships. The default organization's scholarships are public, for
    // the landing page.
    match /programs/{programId} {
      allow read: if resource.data.organizationId == defaultOrgId()
        || inOrg(resource.data.organizationId)
        || isPlatformAdmin();
      allow create: if isOrgAdmin(request.resource.data.organizationId);
      allow update: if isOrgAdmin(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isOrgAdmin(resource.data.organizationId);
    }

    // --------------------------------------------------------- applications
    // ID is {studentId}_{programId}. Status, submission, recommendation state
    // and letters are written only by server actions (S1, S2). The browser
    // writes only uploaded essay files and the free-text fields, and only
    // while the application is a Draft.
    match /applications/{appId} {
      function studentEditableFields() {
        return ['essay', 'qualificationStatement', 'activities', 'essays', 'updatedAt'];
      }

      // `resource == null` comes first: opening a scholarship the student
      // hasn't applied to yet reads a missing document, and `resource.data`
      // on null would deny the whole read. There is nothing to leak.
      allow get: if signedIn() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        isOrgStaff(resource.data.organizationId)
      );
      allow list: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        isOrgStaff(resource.data.organizationId)
      );

      // First write to a new application can come from an essay upload. The
      // application belongs to the scholarship's organization, which must be
      // the student's own (D7).
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && appId == request.auth.uid + '_' + request.resource.data.scholarshipId
        && request.resource.data.get('id', appId) == appId
        && request.resource.data.status == 'Draft'
        && request.resource.data.organizationId == claim('orgId')
        && programOf(request.resource.data.scholarshipId).organizationId == claim('orgId')
        && request.resource.data.keys().hasOnly(
             ['id', 'studentId', 'scholarshipId', 'organizationId', 'status', 'createdAt']
               .concat(studentEditableFields()));

      allow update: if signedIn() && (
        (
          resource.data.studentId == request.auth.uid &&
          resource.data.status == 'Draft' &&
          changed().hasOnly(studentEditableFields())
        ) ||
        // The applicants page sets the decision. Moves to a server action later.
        (
          isOrgAdmin(resource.data.organizationId) &&
          changed().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in ['Submitted', 'In Review', 'Awarded', 'Not Awarded']
        )
      );
      allow delete: if isOrgAdmin(resource.data.organizationId);

      // One review per reviewer: the document ID is the reviewer's UID, so a
      // reviewer can't overwrite someone else's review (S6). Only reviewers
      // assigned to the scholarship can score (F-06), and a submitted review
      // is final. Reads are in the collection-group match below.
      match /reviews/{reviewerId} {
        function application() {
          return get(/databases/$(database)/documents/applications/$(appId)).data;
        }

        allow create, update: if signedIn()
          && reviewerId == request.auth.uid
          && claim('role') in ['reviewer', 'org_admin']
          && application().organizationId == claim('orgId')
          && request.auth.uid in programOf(application().scholarshipId).get('reviewerIds', [])
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.applicationId == appId
          && request.resource.data.organizationId == application().organizationId
          && (resource == null || resource.data.status != 'Submitted');
        allow delete: if false;
      }
    }

    // Collection-group rule for reviews. Rules on a nested path don't apply
    // to collectionGroup() queries, which need the {path=**} form; this one
    // also covers direct reads of applications/{id}/reviews/{uid}. Reviewers
    // read only their own reviews, so they can't see each other's scores.
    match /{path=**}/reviews/{reviewId} {
      allow get: if signedIn() && (
        reviewId == request.auth.uid ||
        isOrgAdmin(resource.data.organizationId)
      );
      allow list: if signedIn() && (
        resource.data.reviewerId == request.auth.uid ||
        isOrgAdmin(resource.data.organizationId)
      );
    }

    // ---------------------------------------------------------------- invites
    // The unguessable invite ID is the credential of a not-yet-registered
    // invitee, so get-by-ID is public. Creating, re-sending and accepting run
    // on the server (src/lib/invites-server.ts).
    match /invites/{inviteId} {
      allow get: if true;
      allow list, delete: if isOrgAdmin(resource.data.organizationId);
      allow create, update: if false;
    }

    match /admin_invites/{inviteId} {
      allow get: if true;
      allow list, delete: if isOrgAdmin(resource.data.organizationId);
      allow create, update: if false;
    }

    // ------------------------------------------------- recommendation tokens
    // The token ID is the recommender's bearer credential, so get-by-ID is
    // public; the page reads only used, cancelled and expiry. Creating,
    // claiming and cancelling are server actions (T5).
    match /recommendationTokens/{tokenId} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // ------------------------------------------------- logs (server-written)
    match /auditLog/{logId} {
      allow read: if isOrgAdmin(resource.data.organizationId);
      allow write: if false;
    }

    // Email outbox. Entries have no organizationId yet, so only the platform
    // admin can read them.
    match /sent_emails/{emailId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ------------------------------------------- legacy role documents
    // No longer a source of roles. The client still reads its own as a
    // fallback for accounts without claims (src/firebase/provider.tsx).
    // Self-creating one is denied (S3).
    match /reviewers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /roles_admin/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
