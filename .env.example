# Firebase web config (Firebase Console > Project Settings > General > Your Apps)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# Main organization new sign-ups join. The same ID is hard-coded in firestore.rules.
NEXT_PUBLIC_DEFAULT_ORG_ID=your-org-id

GEMINI_API_KEY=your-gemini-api-key

# GMAIL_APP_PASSWORD is a 16-char App Password, not the account password.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_FROM_EMAIL=your-address@gmail.com

# Firebase Admin SDK: Project Settings > Service Accounts > Generate New Private Key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the literal \n sequences from the downloaded JSON's private_key field.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Base URL of the deployed app, used for links in outbound emails.
NEXT_PUBLIC_APP_URL=https://your-app.example.com
# Optional. Default is public/email-logo.png attached per message; set this to
# send the logo as a normal <img src> instead.
# EMAIL_LOGO_URL=https://your-app.example.com/email-logo.png
