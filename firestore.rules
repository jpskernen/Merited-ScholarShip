rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SCHOLARSHIP PORTAL SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isSponsor() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role in ['sponsor', 'Admin', 'Sponsor'];
    }

    function isReviewer() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Reviewer') ||
        exists(/databases/$(database)/documents/reviewers/$(request.auth.uid))
      );
    }

    // Roles and Admin Configuration
    match /roles_admin/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }

    // Reviewer Registry
    match /reviewers/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSponsor());
      allow write: if isSponsor();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSponsor() || isReviewer());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Applications - Applicants own theirs, Sponsors/Reviewers can evaluate
    match /applications/{appId} {
      allow read: if isSignedIn() && (
        (resource != null && request.auth.uid == resource.data.applicantId) || 
        isSponsor() || 
        isReviewer()
      );
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource != null && request.auth.uid == resource.data.applicantId) || 
        isSponsor() || 
        isReviewer()
      );
      allow delete: if isSignedIn() && (
        (resource != null && request.auth.uid == resource.data.applicantId) || 
        isSponsor()
      );

      // Nested reviews for committee evaluations
      match /reviews/{reviewId} {
        allow read: if isSignedIn() && (isSponsor() || isReviewer() || request.auth.uid == resource.data.reviewerId);
        allow write: if isSignedIn() && (isSponsor() || isReviewer());
      }
    }

    // Programs (Scholarships) - Anyone signed in can read, only sponsors can manage
    match /programs/{programId} {
      allow read: if isSignedIn();
      allow write: if isSponsor();
    }

    // Fallback for subcollections used by collectionGroup queries
    match /{path=**}/reviews/{reviewDoc} {
      allow read, list: if isSignedIn() && (isSponsor() || isReviewer());
    }
  }
}