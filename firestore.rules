/**
 * @fileoverview Firestore Security Rules for the scholarship application system.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for applicant data and
 * an admin-access model for scholarship management. It uses path-based
 * authorization to control access to user-specific data (applications).
 *
 * Data Structure:
 * - /users/{userId}: Applicant profiles, owned by the user with matching UID.
 * - /users/{userId}/applications/{applicationId}: Applications submitted by an applicant.
 * - /scholarships/{scholarshipId}: Scholarship information, managed by admins.
 * - /applications/{applicationId}/reviews/{reviewId}: Reviews for each application.
 * - /reviewers/{reviewerId}: Reviewer profiles.
 * - /roles_admin/{uid}: Admin role mapping.
 *
 * Key Security Decisions:
 * - Applicants can only access their own profile and applications.
 * - Scholarship data is publicly readable but only writable by admins.
 * - Listing all users is disallowed; access to applicant profiles is restricted to the owner.
 * - The existence of a document in /roles_admin/{uid} grants admin privileges.
 *
 * Denormalization for Authorization:
 * - The system avoids `get()` calls by using path-based ownership for applicant data.
 * - Admin status is determined by the existence of a document in `/roles_admin/{uid}`,
 *   avoiding the need to read user roles from user documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against the authenticated user ID.
     * @return {boolean} True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

        /**
     * @description Checks if the authenticated user ID matches the provided user ID, and the resource exists.
     * @param {string} userId The user ID to compare against the authenticated user ID.
     * @return {boolean} True if the user IDs match, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user has admin privileges.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Defines rules for user profiles.
     * @path /users/{userId}
     * @allow (create) Signed-in user can create their own profile.
     * @allow (get) Signed-in user can get their own profile.
     * @allow (update) Signed-in user can update their own profile.
     * @allow (delete) Signed-in user can delete their own profile.
     * @deny (create) User cannot create a profile with a different user ID.
     * @deny (get) User cannot get another user's profile.
     * @deny (update) User cannot update another user's profile.
     * @deny (delete) User cannot delete another user's profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines rules for applications submitted by a user.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) Signed-in user can create an application under their profile.
     * @allow (get) Signed-in user can get their own application.
     * @allow (update) Signed-in user can update their own application.
     * @allow (delete) Signed-in user can delete their own application.
     * @deny (create) User cannot create an application under another user's profile.
     * @deny (get) User cannot get another user's application.
     * @deny (update) User cannot update another user's application.
     * @deny (delete) User cannot delete another user's application.
     * @principle Enforces document ownership for user applications.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.applicantId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.applicantId == resource.data.applicantId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines rules for scholarship information.
     * @path /scholarships/{scholarshipId}
     * @allow (get) Anyone can read scholarship information.
     * @allow (create) Only admins can create scholarships.
     * @allow (update) Only admins can update scholarships.
     * @allow (delete) Only admins can delete scholarships.
     * @deny (create) Non-admins cannot create scholarships.
     * @deny (update) Non-admins cannot update scholarships.
     * @deny (delete) Non-admins cannot delete scholarships.
     * @principle Admins can manage scholarship information, read access public.
     */
    match /scholarships/{scholarshipId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Defines rules for reviews of applications.
     * @path /applications/{applicationId}/reviews/{reviewId}
     *  // CRITICAL: Cannot implement owner-only writes. No clear owner.
     * @allow (get) Anyone can read review information.
     * @allow (create) Anyone can create reviews.
     * @allow (update) Anyone can update reviews.
     * @allow (delete) Anyone can delete reviews.
     * @principle Admins can manage reviews, read access public.
     */
    match /applications/{applicationId}/reviews/{reviewId} {
          allow get, list: if true;
          allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Defines rules for reviewer profiles.
     * @path /reviewers/{reviewerId}
     * @allow (create) Anyone can read reviewer information.
     * @allow (create) Only the reviewer can create the profile.
     * @allow (update) Only the reviewer can update the profile.
     * @allow (delete) Only the reviewer can delete the profile.
     * @principle Reviewers can manage their profiles.
     */
    match /reviewers/{reviewerId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == reviewerId && request.resource.data.id == request.auth.uid;
        allow update: if isExistingOwner(reviewerId) && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(reviewerId);
    }

       /**
         * @description Admin role assignment. Only assignable by backend functions.
         * @path /roles_admin/{uid}
         * @allow (create) Only assignable by backend functions.
         * @allow (get) Only assignable by backend functions.
         * @allow (update) Only assignable by backend functions.
         * @allow (delete) Only assignable by backend functions.
         * @principle  Admin role assignment..
         */
    match /roles_admin/{uid} {
        allow get: if isAdmin();
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}