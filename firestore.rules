
/**
 * @fileoverview Firestore Security Rules for the scholarship application system.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for applicant data and
 * an admin/reviewer-access model for evaluations. It uses both path-based
 * authorization and role-based checks (via documents and custom claims).
 *
 * Key Security Decisions:
 * - Applicants can only access their own profile and applications.
 * - Reviewers can only see assigned applications and manage their own reviews.
 * - Admins have full oversight.
 * - Access to reviewer/admin metadata is strictly restricted to authorized roles.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has admin privileges (via token claim or document).
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == "admin" ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    /**
     * @description Checks if the user is a reviewer (via token claim or document).
     */
    function isReviewer() {
        return isSignedIn() && (
          request.auth.token.role == "reviewer" ||
          exists(/databases/$(database)/documents/reviewers/$(request.auth.uid))
        );
    }

    /**
     * @description Defines rules for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isReviewer();
      allow list: if isAdmin() || isReviewer();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin(); // Students cannot delete their own profiles once created.
    }

    /**
     * @description Defines rules for applications submitted by a user.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get, list: if isOwner(userId) || isAdmin() || isReviewer();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    /**
     * @description Defines rules for scholarship information.
     */
    match /scholarships/{scholarshipId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Defines rules for reviews of applications.
     * Prevents students (applicants) from ever seeing evaluations.
     */
    match /applications/{applicationId}/reviews/{reviewId} {
      allow get, list: if isAdmin() || isReviewer();
      allow create, update: if isReviewer() && request.resource.data.reviewerId == request.auth.uid;
      allow delete: if false; 
    }

    /**
     * @description Defines rules for reviewer profiles.
     * Restricts viewing reviewer data to admins and the reviewer themselves.
     */
    match /reviewers/{reviewerId} {
        allow get: if isAdmin() || isOwner(reviewerId);
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
    }

    /**
     * @description Admin role assignment. Only assignable by backend functions or manually in console.
     */
    match /roles_admin/{uid} {
        allow get: if isAdmin() || isOwner(uid);
        allow list, create, update, delete: if false;
    }
  }
}
