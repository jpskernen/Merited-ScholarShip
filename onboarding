];

const ROLE_ALIASES = {
  admin: ["admin", "administrator", "owner", "manager"],
  reviewer: ["reviewer", "review", "judge", "panelist", "committee"],
};

/* -------------------------------- helpers --------------------------------- */
let _id = 0;
const uid = (p = "id") => `${p}_${Date.now().toString(36)}_${(_id++).toString(36)}`;

const norm = (s) => (s || "").toString().trim().toLowerCase();

function guessMapping(headers, fieldConfig) {
  const mapping = {};
  fieldConfig.forEach((f) => {
    const hit = headers.find((h) => {
      const nh = norm(h);
      return f.aliases.some((a) => nh === a || nh.includes(a));
    });
    mapping[f.key] = hit || "";
  });
  return mapping;
}

function normalizeRole(raw) {
  const v = norm(raw);
  if (ROLE_ALIASES.admin.some((a) => v.includes(a))) return { role: "admin", guessed: false };
  if (ROLE_ALIASES.reviewer.some((a) => v.includes(a))) return { role: "reviewer", guessed: false };
  return { role: "reviewer", guessed: true };
}

function parseCSVText(text) {
  const result = Papa.parse(text.trim(), { header: true, skipEmptyLines: true });
  const headers = result.meta && result.meta.fields ? result.meta.fields : [];
  const rows = result.data || [];
  return { headers, rows };
}

async function readFileAsText(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = () => reject(new Error("Could not read file"));
    reader.readAsText(file);
  });
}

