
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // High-security check for administrative privileges
    function isSponsor() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role in ['sponsor', 'Admin', 'Sponsor']) ||
        request.auth.token.email == 'peyton.vandenbemden@gmail.com'
      );
    }

    // Check for reviewer registry or specific user role
    function isReviewer() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Reviewer') ||
        exists(/databases/$(database)/documents/reviewers/$(request.auth.uid)) ||
        request.auth.token.email in ['hello@merited.com', 'hellow@meritedapp.com', 'hello@meritedapp.com', 'kernenpm@gmail.com', 'reviewer@test.com'] ||
        isSponsor()
      );
    }

    // Recommendation Tokens
    match /recommendationTokens/{tokenId} {
      // 1. Authenticated students can create tokens (Server Actions use unauthenticated client SDK)
      // 3. Unauthenticated recommenders can READ the token details
      // 4. Unauthenticated recommenders can UPDATE to mark as used
      allow read, update, create: if true;
    }

    // Role Admin Collection
    match /roles_admin/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSponsor());
      allow write: if false; 
    }

    // Reviewer Invites
    match /invites/{inviteId} {
      allow read: if true;
      allow write: if isSponsor();
    }

    // Admin Invites
    match /admin_invites/{inviteId} {
      allow read: if true;
      allow write: if isSponsor();
    }

    // Sent Emails Outbox
    match /sent_emails/{emailId} {
      allow read, write: if true; // Support server-side logging
    }

    // User Profiles / Applications
    match /users {
      allow list: if isSignedIn() && (isSponsor() || isReviewer());
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSponsor() || isReviewer());
      
      // 2. Authenticated students to update their own application
      // 5. Unauthenticated users (recommenders) to update for letter URL
      // Note: allow update is set to true to support public letter uploads and server-side status updates.
      allow update: if true;
      
      allow create: if isSignedIn() && (request.auth.uid == userId || isSponsor());
      allow delete: if isSponsor();
    }

    // Reviewers Registry
    match /reviewers/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSponsor());
      allow write: if isSponsor() || (isSignedIn() && request.auth.uid == userId);
    }

    // Applications & History
    match /applications/{appId} {
      allow read: if isSignedIn() && (
        (resource != null && request.auth.uid == resource.data.applicantId) || 
        isSponsor() || 
        isReviewer()
      );
      allow write: if isSignedIn();

      match /reviews/{reviewId} {
        allow read: if isSignedIn() && (isSponsor() || isReviewer() || (resource != null && request.auth.uid == resource.data.reviewerId));
        allow write: if isSignedIn() && (isSponsor() || isReviewer());
      }
    }

    // Programs are public for viewing
    match /programs/{programId} {
      allow read: if true;
      allow write: if isSponsor();
    }

    // Allow collection group queries for reviews
    match /{path=**}/reviews/{reviewDoc} {
      allow read, list, write: if isSignedIn() && (isSponsor() || isReviewer());
    }
  }
}
