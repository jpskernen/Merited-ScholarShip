
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isReviewer() {
      return exists(/databases/$(database)/documents/reviewers/$(request.auth.uid));
    }

    match /recommendations/{tokenId} {
      allow read: if request.auth != null && (isReviewer() || isAdmin());
      allow write: if true;
    }

    match /applications/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isReviewer());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /{userId}/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isReviewer());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
